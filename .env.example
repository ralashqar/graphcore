# Hosted GraphCore project defaults for browser/dev usage.
# Copy to `.env` for the shared hosted backend.
VITE_APP_PROFILE=full
VITE_SUPABASE_URL=https://znwdatidqdkzidempvkt.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_5EkU5knI16oAgqxPMYPxnw_Sb8QOgdS

# Landing-only deployments should set VITE_APP_PROFILE=landing and point these
# waitlist variables at the waitlist backend. For shared-backend testing, these
# can point at the same Supabase project as VITE_SUPABASE_URL.
VITE_PUBLIC_SITE_URL=https://synarc.ai
VITE_WAITLIST_SUPABASE_URL=https://znwdatidqdkzidempvkt.supabase.co
VITE_WAITLIST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5EkU5knI16oAgqxPMYPxnw_Sb8QOgdS
VITE_WAITLIST_FUNCTION_NAME=join-waitlist
VITE_WAITLIST_TURNSTILE_SITE_KEY=

# Supabase Edge Function secrets for waitlist confirmation email. Set these
# with `npx supabase secrets set ...`; do not expose RESEND_API_KEY to clients.
RESEND_API_KEY=
WAITLIST_CONFIRMATION_FROM=SynArc <hello@synarc.dev>
WAITLIST_REPLY_TO=
WAITLIST_CONFIRMATION_ENABLED=true

# Dedicated prompt-to-game workspace. Keep public rollout off until acceptance passes.
VITE_GAME_BUILDER_ENABLED=false
VITE_GAME_PREVIEW_URL=https://graphcore-game-preview.fly.dev
VITE_GAME_RELEASE_URL=https://znwdatidqdkzidempvkt.supabase.co/functions/v1/get-game-release
# Server-side game admission and quoted credit reservations.
GAME_GENERATION_ENABLED=false
GAME_GENERATION_USERS=
GAME_PLAN_CREDITS=25
GAME_ASSET_CREDITS=150
GAME_MODULES_ENABLED=false
GAME_UNIFIED_ENABLED=false
GAME_MECHANICS_ENABLED=false

# Server-only City Deals pilot gate; enable after staging entitlement/checkout acceptance.
CITY_DEALS_ENABLED=false

# Server-only City customer discovery; enable after isolated staging acceptance.
CITY_CUSTOMER_DISCOVERY_ENABLED=false

# Launch discovery and temporary organic Plaza (staging-only until accepted)
CITY_LAUNCHES_ENABLED=false
CITY_LAUNCH_PLAZA_ENABLED=false

# City sprite generation: configure on both Edge and the existing world worker.
CITY_BUILDING_ART_ENABLED=false
# Positive SynArc credit prices required before enabling each model. No new budget ledger.
CITY_ART_NANO_CREDITS=0
CITY_ART_GPT_CREDITS=0

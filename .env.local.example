# Local Supabase stack example.
# Copy to `.env.local` only when running `npm run supabase:start`.
VITE_APP_PROFILE=full
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=replace-with-the-anon-key-from-npm-run-supabase:status

# Optional landing-only test profile. Use `npm run dev:landing` to force this
# without editing the file. Point these at local Supabase for local function
# testing, or at the hosted project while using the shared backend.
VITE_PUBLIC_SITE_URL=http://127.0.0.1:4176
VITE_WAITLIST_SUPABASE_URL=http://127.0.0.1:54321
VITE_WAITLIST_SUPABASE_PUBLISHABLE_KEY=replace-with-the-anon-key-from-npm-run-supabase:status
VITE_WAITLIST_FUNCTION_NAME=join-waitlist
VITE_WAITLIST_TURNSTILE_SITE_KEY=

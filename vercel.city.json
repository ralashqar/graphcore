{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/city-property.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/city-share.ts": {
      "includeFiles": "public/fonts/Manrope.ttf"
    }
  },
  "rewrites": [
    {
      "source": "/city/deal/:slug",
      "destination": "/api/city-property?kind=deal&slug=:slug"
    },
    {
      "source": "/city/trails/:slug",
      "destination": "/api/city-property?kind=trail&slug=:slug"
    },
    {
      "source": "/city/launches/:slug",
      "destination": "/api/city-property?kind=launch&slug=:slug"
    },
    {
      "source": "/city/business/:slug",
      "destination": "/api/city-property?slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
